---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="brand" aria-label="Tixible home">
          <img src="/assets/brand/tixible/icon.webp" width="32" height="32" alt="Tixible logo" loading="lazy" decoding="async">
          <span class="brand-word">Tixible</span>
        </a>
        <p>Build. Connect. Scale. A technology company currently focused on Closure, a daily decision companion for small business owners.</p>
        <div class="footer-social">
          <span class="footer-social-item" title="Official accounts coming soon" aria-disabled="true"><svg width="16" height="16"><use href="#i-github"/></svg></span>
          <span class="footer-social-item" title="Official accounts coming soon" aria-disabled="true"><svg width="16" height="16"><use href="#i-linkedin"/></svg></span>
          <span class="footer-social-item" title="Official accounts coming soon" aria-disabled="true"><svg width="16" height="16"><use href="#i-x-social"/></svg></span>
          <span class="footer-social-item" title="Official accounts coming soon" aria-disabled="true"><svg width="16" height="16"><use href="#i-instagram"/></svg></span>
          <span class="footer-social-item" title="Official accounts coming soon" aria-disabled="true"><svg width="16" height="16"><use href="#i-youtube"/></svg></span>
        </div>
      </div>
      <div class="footer-col">
        <h4>Product</h4>
        <ul>
          <li><a href="/closure">Closure</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          <li><a href="/#about">About</a></li>
          <li><a href="/#story">Company story</a></li>
          <li><a href="/#founder">Founder</a></li>
          <li><a href="/#careers">Careers</a></li>
          <li><a href="/#contact">Contact</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Resources</h4>
        <ul>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/roadmap">Roadmap</a></li>
          <li><a href="/press">Press kit</a></li>
          <li><a href="/status">System status</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Legal</h4>
        <ul>
          <li><a href="/legal/privacy">Privacy policy</a></li>
          <li><a href="/legal/terms">Terms of service</a></li>
          <li><a href="/legal/cookies">Cookie policy</a></li>
          <li><a href="/legal/security">Security</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} Tixible. All rights reserved. Founded by Emmanuel Chukwunweike Nwakor.</span>
      <a href="/status" class="footer-status"><span class="pulse pulse-amber"></span> Pre-launch</a>
    </div>
  </div>
</footer>
