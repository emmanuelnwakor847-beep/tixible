---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const recentPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<BaseLayout
  title="Tixible — building Closure for small business owners"
  description="Tixible is a technology company currently focused on one product: Closure, a daily decision companion that helps small business owners know the truth about their business every night."
>

<!-- ================= HERO ================= -->
<section class="hero">
  <div class="container">
    <div class="hero-copy">
      <div class="eyebrow eyebrow-light">Tixible</div>
      <h1>We're building one product.<br><span>On purpose.</span></h1>
      <p class="hero-sub">Tixible is currently focused entirely on Closure — a daily decision companion for small business owners. We'd rather build one thing properly than promise a platform before we've earned it.</p>
      <div class="hero-cta">
        <a href="/closure" class="btn btn-primary btn-lg">Meet Closure</a>
        <a href="/closure#follow" class="btn btn-ghost btn-lg">Get Notified</a>
      </div>
      <div class="hero-meta">
        <div class="hero-meta-item"><svg width="16" height="16"><use href="#i-check-circle"/></svg> Founder-led</div>
        <div class="hero-meta-item"><svg width="16" height="16"><use href="#i-check-circle"/></svg> Built with real business owners</div>
        <div class="hero-meta-item"><svg width="16" height="16"><use href="#i-check-circle"/></svg> Honest about where we are</div>
      </div>
    </div>

    <div class="hero-visual">
      <a href="/closure" class="hero-product-card" data-reveal>
        <span class="product-hero-icon-mono hero-product-icon" style="background:var(--gradient-primary);"><svg width="24" height="24"><use href="#i-moon"/></svg></span>
        <div class="hero-product-copy">
          <div class="hero-product-name">Closure <span class="badge badge-soon">Concept Validation</span></div>
          <p>A daily decision companion that helps small business owners know the truth about their business, every night.</p>
        </div>
        <svg width="18" height="18" class="hero-product-arrow"><use href="#i-arrow-right"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- ================= TRUST STRIP ================= -->
<section class="trust-strip">
  <div class="container">
    <div class="trust-grid">
      <div class="trust-item" data-reveal><span class="trust-icon"><svg width="20" height="20"><use href="#i-users"/></svg></span><span>Founder-led</span></div>
      <div class="trust-item" data-reveal><span class="trust-icon"><svg width="20" height="20"><use href="#i-target"/></svg></span><span>Built with real business owners</span></div>
      <div class="trust-item" data-reveal><span class="trust-icon"><svg width="20" height="20"><use href="#i-shield"/></svg></span><span>Privacy-minded by default</span></div>
      <div class="trust-item" data-reveal><span class="trust-icon"><svg width="20" height="20"><use href="#i-pin"/></svg></span><span>Based in Abuja, Nigeria</span></div>
      <div class="trust-item" data-reveal><span class="trust-icon"><svg width="20" height="20"><use href="#i-compass"/></svg></span><span>Honest about where we are</span></div>
    </div>
  </div>
</section>

<!-- ================= ABOUT ================= -->
<section class="section-pad" id="about">
  <div class="container">
    <div class="about-grid">
      <div data-reveal>
        <div class="eyebrow">About Tixible</div>
        <h2 style="font-size:var(--text-4xl);margin-bottom:var(--space-5);">Why Tixible exists</h2>
        <p style="font-size:var(--text-md);margin-bottom:var(--space-4);">Most software companies chase breadth before they've proven depth — shipping a platform's worth of promises before a single product has actually earned trust. We think that's backwards.</p>
        <p style="margin-bottom:var(--space-4);">Tixible exists to help small business owners know the truth about their business, starting with one moment: closing up for the night. Right now, that means one product, built properly, rather than many products built quickly.</p>
        <p>Our guiding principle is simple: earn the right to expand. We won't build a second product, feature, or platform narrative until Closure has actually earned it — through real evidence, not assumption.</p>
      </div>
      <div class="about-panel" data-reveal>
        <div class="about-panel-row">
          <svg width="20" height="20"><use href="#i-target"/></svg>
          <div><h4>The problem</h4><p>Small business owners close their day on a guess — a cash count, a notebook tally, a mental estimate — with no certainty attached to it.</p></div>
        </div>
        <div class="about-panel-row">
          <svg width="20" height="20"><use href="#i-compass"/></svg>
          <div><h4>Our approach</h4><p>Solve one real, specific problem before attempting to solve many. Validate in the field before writing a feature list.</p></div>
        </div>
        <div class="about-panel-row">
          <svg width="20" height="20"><use href="#i-rocket"/></svg>
          <div><h4>The ambition</h4><p>A durable company built product by product — where the next one only gets built once the first has genuinely earned it.</p></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= CLOSURE SPOTLIGHT ================= -->
<section class="section-pad" style="background:var(--color-bg-subtle);">
  <div class="container">
    <div class="spotlight" data-reveal>
      <div class="spotlight-top">
        <span class="product-hero-icon-mono" style="width:56px;height:56px;border-radius:14px;background:var(--gradient-primary);"><svg width="26" height="26"><use href="#i-moon"/></svg></span>
        <div>
          <span class="badge badge-soon">Concept Validation · Early Development</span>
        </div>
      </div>
      <h2>Closure — a daily decision companion for small business owners.</h2>
      <p class="lead">Every business owner already closes their day somehow. Closure sits inside that existing ritual and answers one question with certainty: did I actually make money today, and what's the one thing to do about it tomorrow. One number, one action — not a dashboard.</p>

      <div class="spotlight-foot">
        <div class="spotlight-who">
          <div><strong>Small business owners</strong>who want certainty at closing time, not another app to learn.</div>
          <div><strong>Owners who already keep a notebook</strong>and want it to finally add up.</div>
        </div>
        <div class="spotlight-cta">
          <a href="/closure" class="btn btn-primary">Meet Closure</a>
          <a href="/closure#follow" class="btn btn-ghost">Get notified</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= WHY TIXIBLE ================= -->
<section class="section-pad" id="why-tixible">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Why Tixible</div>
      <h2>What makes the company different</h2>
      <p>Not features — the discipline underneath them. Here's what we optimize for that most early-stage software companies don't.</p>
    </div>
    <div class="why-grid">
      <div class="why-card card" data-reveal><div class="why-num">01</div><h3>Focused, not scattered</h3><p>One product gets our full attention instead of five getting a quarter of it each.</p></div>
      <div class="why-card card" data-reveal><div class="why-num">02</div><h3>Premium design philosophy</h3><p>Interfaces are treated as a product decision, not a final coat of paint applied at the end.</p></div>
      <div class="why-card card" data-reveal><div class="why-num">03</div><h3>Field validation before code</h3><p>Real conversations with real business owners shape Closure before features get locked in.</p></div>
      <div class="why-card card" data-reveal><div class="why-num">04</div><h3>Security-minded architecture</h3><p>Access and data handling are designed in from the first line of code, not patched on later.</p></div>
      <div class="why-card card" data-reveal><div class="why-num">05</div><h3>Long-term product thinking</h3><p>We'd rather ship one product well than many products carelessly.</p></div>
      <div class="why-card card" data-reveal><div class="why-num">06</div><h3>Earn the right to expand</h3><p>No second product until the first has actually proven itself — through evidence, not ambition.</p></div>
    </div>
  </div>
</section>

<!-- ================= MISSION / VISION / PRINCIPLES ================= -->
<section class="section-pad mvp-bg">
  <div class="container">
    <div class="section-head center" style="margin-bottom:var(--space-10);">
      <div class="eyebrow eyebrow-light" style="justify-content:center;">Direction</div>
      <h2 style="color:#fff;">Mission, vision, and how we get there</h2>
    </div>
    <div class="mvp-grid" data-reveal>
      <div class="mvp-card">
        <div class="mvp-icon"><svg width="22" height="22"><use href="#i-target"/></svg></div>
        <h3>Mission</h3>
        <p>To empower businesses with intelligent software that makes work simpler, faster, and more connected — starting with helping small business owners know the truth about their business every night.</p>
      </div>
      <div class="mvp-card">
        <div class="mvp-icon"><svg width="22" height="22"><use href="#i-compass"/></svg></div>
        <h3>Vision</h3>
        <p>To become one of the world's leading enterprise technology companies powering millions of businesses globally — one properly earned product at a time.</p>
      </div>
      <div class="mvp-card">
        <div class="mvp-icon"><svg width="22" height="22"><use href="#i-rocket"/></svg></div>
        <h3>Long-term direction</h3>
        <p>Closure has to earn its place first — through real field evidence, real retention, and real validation, in that order. Nothing after it gets built until it does.</p>
      </div>
    </div>

    <div class="principles-list">
      <div class="principle" data-reveal><span class="mark">01</span><h4>Solve one problem first</h4><p>Depth before breadth, every time.</p></div>
      <div class="principle" data-reveal><span class="mark">02</span><h4>Compete with the habit</h4><p>The bar is the notebook, not other software.</p></div>
      <div class="principle" data-reveal><span class="mark">03</span><h4>Earn trust, don't claim it</h4><p>Show the reasoning; let the owner correct it.</p></div>
      <div class="principle" data-reveal><span class="mark">04</span><h4>Never claim more than we've built</h4><p>Status on this site always matches reality.</p></div>
    </div>
  </div>
</section>

<!-- ================= COMPANY STORY / TIMELINE ================= -->
<section class="section-pad" id="story">
  <div class="container">
    <div class="section-head center">
      <div class="eyebrow" style="justify-content:center;">Company Story</div>
      <h2>How Tixible is being built</h2>
      <p>Tixible is an early, founder-led company, deliberately focused on one product until it has earned the right to expand.</p>
    </div>
    <div class="timeline">
      <div class="timeline-item" data-reveal>
        <div class="timeline-dot"><svg width="16" height="16"><use href="#i-sparkles"/></svg></div>
        <div class="timeline-year">Stage 01 — Research &amp; Discovery</div>
        <h3>Tixible is founded</h3>
        <p>Tixible starts as a founder-led company with one conviction: software worth trusting is validated with real people before it's built, not after.</p>
      </div>
      <div class="timeline-item" data-reveal>
        <div class="timeline-dot"><svg width="16" height="16"><use href="#i-moon"/></svg></div>
        <div class="timeline-year">Stage 02 — Concept Validation (now)</div>
        <h3>Closure takes shape through real conversations</h3>
        <p>Closure is being shaped directly with the small business owners it's meant for — before a single feature is locked in.</p>
      </div>
      <div class="timeline-item future" data-reveal>
        <div class="timeline-dot"><svg width="16" height="16"><use href="#i-code"/></svg></div>
        <div class="timeline-year">Stage 03 — Prototype &amp; internal development</div>
        <h3>What Closure becomes next</h3>
        <p>Once the field work holds up, Closure moves into a working prototype, then private alpha with a small group of real owners.</p>
      </div>
      <div class="timeline-item future" data-reveal>
        <div class="timeline-dot"><svg width="16" height="16"><use href="#i-compass"/></svg></div>
        <div class="timeline-year">What's next</div>
        <h3>Earning the right to expand</h3>
        <p>The long-term goal starts with one product that's genuinely trusted. Anything beyond Closure waits until that's true.</p>
      </div>
    </div>
  </div>
</section>

<!-- ================= FOUNDER ================= -->
<section class="section-pad" id="founder" style="background:var(--color-bg-subtle);">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Founder</div>
      <h2>Founder-led, by design</h2>
    </div>
    <div class="founder-grid">
      <div class="founder-card" data-reveal>
        <img class="founder-avatar-photo" src="/assets/founder.webp" width="96" height="96" alt="Emmanuel Chukwunweike Nwakor, Founder and CEO of Tixible" loading="lazy" decoding="async" />
        <h3>Emmanuel Chukwunweike Nwakor</h3>
        <div class="role">Founder &amp; CEO, Tixible</div>
        <div class="founder-socials">
          <span class="footer-social-item" title="Official accounts coming soon" aria-disabled="true"><svg width="16" height="16"><use href="#i-github"/></svg></span>
          <span class="footer-social-item" title="Official accounts coming soon" aria-disabled="true"><svg width="16" height="16"><use href="#i-linkedin"/></svg></span>
          <span class="footer-social-item" title="Official accounts coming soon" aria-disabled="true"><svg width="16" height="16"><use href="#i-x-social"/></svg></span>
          <span class="footer-social-item" title="Official accounts coming soon" aria-disabled="true"><svg width="16" height="16"><use href="#i-instagram"/></svg></span>
          <span class="footer-social-item" title="Official accounts coming soon" aria-disabled="true"><svg width="16" height="16"><use href="#i-youtube"/></svg></span>
        </div>
        <div class="founder-meta">
          <div><svg width="16" height="16"><use href="#i-mail"/></svg><span>[YOUR EMAIL]</span></div>
          <div><svg width="16" height="16"><use href="#i-pin"/></svg><span>Abuja, Nigeria</span></div>
        </div>
      </div>
      <div data-reveal>
        <p class="founder-quote">"I want Tixible to still be building thoughtful software <span>ten years from now</span> — which means earning every product we build, starting with this one."</p>
        <div class="founder-bio">
          <p>Tixible exists to help small business owners know the truth about their business, starting with one moment: closing up for the night. It's built by a founder who cares about design, product quality, and the discipline to validate before building — not just ship something and call it done.</p>
          <p>That discipline is the whole strategy right now: one product, Closure, built properly with real business owners, before anything else gets added to the roadmap.</p>
        </div>
        <div class="founder-signoff">
          <img src="/assets/brand/tixible/icon.webp" width="40" height="40" alt="" style="width:40px;height:40px;border-radius:10px;" loading="lazy" decoding="async" />
          <div>
            <div class="founder-signoff-name">Emmanuel Chukwunweike Nwakor</div>
            <div class="founder-signoff-role">Founder &amp; CEO, Tixible</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= FROM THE BLOG ================= -->
{recentPosts.length > 0 && (
  <section class="section-pad">
    <div class="container">
      <div class="section-head center">
        <div class="eyebrow" style="justify-content:center;">From the blog</div>
        <h2>Notes from Tixible</h2>
        <p>Product updates and thinking behind Closure, written as it happens.</p>
      </div>
      <div class="blog-grid">
        {recentPosts.map((post) => (
          <a href={`/blog/${post.id}`} class="blog-card card card-hover" data-reveal>
            <div class="blog-card-meta">
              <svg width="14" height="14"><use href="#i-calendar"/></svg>
              {post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
            </div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <div class="tags">{post.data.tags.map((t) => <span class="tag-chip">{t}</span>)}</div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<!-- ================= CAREERS ================= -->
<section class="section-pad" id="careers">
  <div class="container">
    <div class="careers-wrap">
      <div data-reveal>
        <div class="eyebrow">Careers</div>
        <h2 style="font-size:var(--text-4xl);margin-bottom:var(--space-5);">Help build Closure</h2>
        <p style="font-size:var(--text-md);margin-bottom:var(--space-6);">Tixible is early and founder-led. We're not hiring at scale yet — but we're already thinking about the kind of people we'll want to bring on first.</p>
        <div class="careers-values">
          <div class="careers-value"><h4>Ownership</h4><p>You'll build things end to end, not a sliver of a ticket.</p></div>
          <div class="careers-value"><h4>Craft</h4><p>We'd rather do less, and do it properly.</p></div>
          <div class="careers-value"><h4>Curiosity</h4><p>Good questions matter as much as fast answers.</p></div>
          <div class="careers-value"><h4>Long-term thinking</h4><p>We're building for years, not for a demo.</p></div>
        </div>
      </div>
      <div data-reveal>
        <div class="careers-roles">
          <a class="role-row" href="#contact"><div><h4>Product Engineer</h4><span>Remote · Future opening</span></div><svg class="arrow" width="18" height="18"><use href="#i-arrow-right"/></svg></a>
          <a class="role-row" href="#contact"><div><h4>Product Designer</h4><span>Remote · Future opening</span></div><svg class="arrow" width="18" height="18"><use href="#i-arrow-right"/></svg></a>
          <a class="role-row" href="#contact"><div><h4>User Researcher</h4><span>Remote · Future opening</span></div><svg class="arrow" width="18" height="18"><use href="#i-arrow-right"/></svg></a>
          <a class="role-row" href="#contact"><div><h4>Don't see your role?</h4><span>Introduce yourself anyway</span></div><svg class="arrow" width="18" height="18"><use href="#i-arrow-right"/></svg></a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= CONTACT ================= -->
<section class="section-pad" id="contact" style="background:var(--color-bg-subtle);">
  <div class="container">
    <div class="section-head center">
      <div class="eyebrow" style="justify-content:center;">Contact</div>
      <h2>Talk to Tixible</h2>
      <p>Whether you're a business owner curious about Closure, thinking about a partnership, or just want to say hello — here's how to reach us.</p>
    </div>

    <div class="contact-grid">
      <div data-reveal>
        <div class="contact-channels">
          <div class="contact-channel">
            <div class="contact-channel-left"><span class="contact-channel-icon"><svg width="18" height="18"><use href="#i-moon"/></svg></span><div><h4>Closure</h4><p>Questions about the product or field validation</p></div></div>
            <a class="link" href="mailto:hello@tixible.com">hello@tixible.com</a>
          </div>
          <div class="contact-channel">
            <div class="contact-channel-left"><span class="contact-channel-icon"><svg width="18" height="18"><use href="#i-git-branch"/></svg></span><div><h4>Partnerships</h4><p>Collaborations and introductions</p></div></div>
            <a class="link" href="mailto:partners@tixible.com">partners@tixible.com</a>
          </div>
          <div class="contact-channel">
            <div class="contact-channel-left"><span class="contact-channel-icon"><svg width="18" height="18"><use href="#i-sparkles"/></svg></span><div><h4>Media</h4><p>Press and brand inquiries</p></div></div>
            <a class="link" href="mailto:press@tixible.com">press@tixible.com</a>
          </div>
          <div class="contact-channel">
            <div class="contact-channel-left"><span class="contact-channel-icon"><svg width="18" height="18"><use href="#i-users"/></svg></span><div><h4>Careers</h4><p>Introduce yourself</p></div></div>
            <a class="link" href="mailto:careers@tixible.com">careers@tixible.com</a>
          </div>
        </div>

        <div class="contact-direct">
          <dl>
            <dt>Full Name</dt><dd>Emmanuel Chukwunweike Nwakor</dd>
            <dt>Company</dt><dd>Tixible</dd>
            <dt>Role</dt><dd>Founder / CEO</dd>
            <dt>Email</dt><dd>[YOUR EMAIL ADDRESS]</dd>
            <dt>Location</dt><dd>Abuja, Nigeria</dd>
            <dt>Website</dt><dd>tixible.com</dd>
            <dt>GitHub</dt><dd>[YOUR GITHUB PROFILE]</dd>
          </dl>
        </div>
      </div>

      <div data-reveal>
        <form class="form-card" id="contactForm" novalidate data-contact-email="hello@tixible.com">
          <div class="field honeypot" aria-hidden="true">
            <label for="companyWebsite">Leave this field empty</label>
            <input id="companyWebsite" name="companyWebsite" type="text" tabindex="-1" autocomplete="off">
          </div>
          <div class="form-row">
            <div class="field"><label for="fullName">Full name</label><input id="fullName" name="fullName" type="text" placeholder="Jane Doe" maxlength="120" required></div>
            <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" placeholder="you@company.com" maxlength="180" required></div>
          </div>
          <div class="form-row">
            <div class="field"><label for="company">Company</label><input id="company" name="company" type="text" placeholder="Company name" maxlength="150"></div>
            <div class="field">
              <label for="subject">Subject</label>
              <select id="subject" name="subject" required>
                <option value="">Choose a topic</option>
                <option>Closure</option>
                <option>Partnerships</option>
                <option>Media</option>
                <option>Careers</option>
                <option>Something else</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="Tell us a bit about what you're looking for..." maxlength="4000" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-block btn-lg">Send Message</button>
          <div class="form-note"><svg width="14" height="14"><use href="#i-lock"/></svg> We'll only use this to respond to your message.</div>
          <div class="toast" id="toast" role="status" aria-live="polite"><svg width="18" height="18"><use href="#i-check-circle"/></svg><span id="toastMsg">Message sent</span></div>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- ================= FINAL CTA ================= -->
<section class="section-pad">
  <div class="container">
    <div class="final-cta" data-reveal>
      <h2>Curious where Closure goes next?</h2>
      <p>Meet the product, or get notified as it moves through validation.</p>
      <div class="final-cta-buttons">
        <a href="/closure" class="btn btn-primary btn-lg">Meet Closure</a>
        <a href="/closure#follow" class="btn btn-ghost btn-lg">Get Notified</a>
      </div>
      <div class="final-cta-links">
        <a href="/blog">Read the blog <svg width="14" height="14"><use href="#i-arrow-up-right"/></svg></a>
        <a href="#contact">Contact us <svg width="14" height="14"><use href="#i-arrow-up-right"/></svg></a>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
