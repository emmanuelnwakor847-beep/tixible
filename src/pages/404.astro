---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — Tixible" description="This page doesn't exist or has moved.">

<section class="hero" style="padding-bottom:var(--space-24);">
  <div class="container">
    <div class="hero-copy">
      <div class="eyebrow eyebrow-light">404</div>
      <h1>This page doesn't exist.</h1>
      <p class="hero-sub">It may have moved, or the link might just be wrong. Either way, here's how to get back on track.</p>
      <div class="hero-cta">
        <a href="/" class="btn btn-primary btn-lg">Back to homepage</a>
        <a href="/closure" class="btn btn-ghost btn-lg">Meet Closure</a>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
