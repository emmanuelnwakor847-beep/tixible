---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Press Kit — Tixible" description="Company facts, founder bio, and brand assets for journalists and media covering Tixible.">

<section class="blog-hero">
  <div class="container">
    <div class="eyebrow">Press Kit</div>
    <h1>Press &amp; media resources</h1>
    <p>Everything you need to write about Tixible accurately. For anything not covered here, reach out directly.</p>
  </div>
</section>

<section class="section-pad">
  <div class="container" style="max-width:720px;">
    <h2 style="font-size:var(--text-2xl);margin-bottom:var(--space-4);">Company facts</h2>
    <dl class="contact-direct" style="margin:0 0 var(--space-12);">
      <dt>Name</dt><dd>Tixible</dd>
      <dt>Founded &amp; owned by</dt><dd>Emmanuel Chukwunweike Nwakor (Founder &amp; CEO)</dd>
      <dt>Headquarters</dt><dd>Abuja, Nigeria</dd>
      <dt>Product</dt><dd>Closure — a daily decision companion for small business owners (Concept Validation stage)</dd>
      <dt>Website</dt><dd>tixible.com</dd>
    </dl>

    <h2 style="font-size:var(--text-2xl);margin-bottom:var(--space-4);">Boilerplate</h2>
    <p style="margin-bottom:var(--space-12);">Tixible is a technology company founded and led by Emmanuel Chukwunweike Nwakor. It is currently focused on Closure, a daily decision companion that helps small business owners know the truth about their business every night. Tixible is deliberately building one product at a time — the company's guiding principle is to earn the right to expand rather than build a platform before a single product has proven itself.</p>

    <h2 style="font-size:var(--text-2xl);margin-bottom:var(--space-4);">Brand assets</h2>
    <div class="card" style="padding:var(--space-6);text-align:center;max-width:280px;margin-bottom:var(--space-6);">
      <img src="/assets/brand/tixible/icon.webp" width="72" height="72" alt="Tixible logo, dark version" style="margin-inline:auto;margin-bottom:var(--space-4);border-radius:16px;">
      <p style="font-size:var(--text-sm);margin-bottom:var(--space-4);">Primary logo (dark)</p>
      <a class="btn btn-secondary btn-sm" href="/assets/brand/tixible/icon.png" download>Download PNG</a>
    </div>
    <p style="font-size:var(--text-sm);color:var(--color-text-tertiary);">Please don't redraw, recolor, or alter the proportions of the logo. For additional formats or a full brand guide, email us below.</p>
  </div>
</section>

<section class="section-pad" style="background:var(--color-bg-subtle);">
  <div class="container" style="max-width:640px;text-align:center;">
    <h2 style="font-size:var(--text-2xl);margin-bottom:var(--space-4);">Media inquiries</h2>
    <p style="margin-bottom:var(--space-6);">For interviews, quotes, or anything else: <a href="mailto:press@tixible.com">press@tixible.com</a></p>
    <a href="/#contact" class="btn btn-primary">Contact us</a>
  </div>
</section>

</BaseLayout>
