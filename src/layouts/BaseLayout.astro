---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import IconSprite from '../components/IconSprite.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage = '/assets/brand/tixible/og-image.jpg',
  ogType = 'website',
  structuredData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const absoluteOgImage = new URL(ogImage, Astro.site).toString();

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Tixible',
  url: 'https://tixible.com',
  logo: new URL('/assets/brand/tixible/icon.png', Astro.site).toString(),
  description: 'Tixible is a technology company currently focused on Closure, a daily decision companion that helps small business owners know the truth about their business every night.',
  founder: {
    '@type': 'Person',
    name: 'Emmanuel Chukwunweike Nwakor',
    jobTitle: 'Founder & CEO',
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Tixible',
  url: 'https://tixible.com',
};

const extraSchemas = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];

// Prevent "</script>" in any field (e.g. a CMS-authored title) from breaking out of the JSON-LD script tag.
function toSafeJson(obj: unknown) {
  return JSON.stringify(obj).replace(/</g, '\\u003c');
}
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonicalURL}>
<link rel="icon" type="image/png" href="/assets/brand/tixible/icon.png">
<link rel="apple-touch-icon" href="/assets/brand/tixible/icon.png">

<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={absoluteOgImage}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="Tixible">
<meta name="theme-color" content="#0B1020">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={absoluteOgImage}>

<script type="application/ld+json" set:html={toSafeJson(organizationSchema)} />
<script type="application/ld+json" set:html={toSafeJson(websiteSchema)} />
{extraSchemas.map((schema) => (
  <script type="application/ld+json" set:html={toSafeJson(schema)} />
))}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@500;600;700;800&display=swap">

<!-- Plausible Analytics — create your site at https://plausible.io first, domain must match exactly -->
<script defer data-domain="tixible.com" src="https://plausible.io/js/script.js"></script>
</head>
<body>
<a href="#main" class="skip-link">Skip to content</a>
<IconSprite />
<Nav />
<main id="main">
  <slot />
</main>
<Footer />
<script src="../scripts/main.js"></script>
</body>
</html>
